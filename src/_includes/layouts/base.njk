<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {# ── Per-page title & description ──────────────────────────────
     `metaTitle` / `metaDescription` are the SEO values (the <title> tag).
     They fall back to the visible `title` / `description`, then to site defaults.
     Set `metaTitle` in a page's front matter to use the long Phase 0 titles
     WITHOUT changing the visible heading/brand. #}
  {% set pageTitle = metaTitle or title or site.title %}
  {% set pageDesc  = metaDescription or description or facts.positioning.line %}
  {% set canonical = site.url + page.url %}
  {% set pageImage = image or site.image %}
  {% set pageOgType = ogType or "website" %}
  {% set pageImageAlt = imageAlt or pageTitle %}
  {% set pageModified = page | lastModified %}
  {% set pageSchemaType = schemaType or "WebPage" %}

  <title>{{ pageTitle }}</title>
  <meta name="title" content="{{ pageTitle }}">
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">

  {# Utility pages (thank-you, etc.) set `noindex: true` so they stay out of
     search results and AI answer engines. Everything else invites full
     indexing, including large snippets — answer engines quote from these. #}
  {% if noindex %}
  <meta name="robots" content="noindex, follow">
  {% else %}
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  {% endif %}

  <meta property="og:type" content="{{ pageOgType }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:alt" content="{{ pageImageAlt }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  {%- if pageOgType == "article" %}
  <meta property="article:published_time" content="{{ page.date | isoDateTime }}">
  <meta property="article:modified_time" content="{{ pageModified | isoDateTime }}">
  <meta property="article:author" content="{{ site.url }}/about/">
  {%- for tag in hashtags %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor %}
  {%- endif %}

  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="{{ canonical }}">
  <meta property="twitter:title" content="{{ pageTitle }}">
  <meta property="twitter:description" content="{{ pageDesc }}">
  <meta property="twitter:image" content="{{ pageImage }}">
  <meta property="twitter:image:alt" content="{{ pageImageAlt }}">
  <meta name="twitter:site" content="{{ site.twitterHandle }}">
  <meta name="twitter:creator" content="{{ site.twitterHandle }}">
  <meta name="author" content="{{ site.name }}">
  <link rel="alternate" type="application/atom+xml" title="Insights on AI in Agriculture — {{ site.name }}" href="{{ site.url }}/feed.xml">

  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.google }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.analytics.google }}');
  </script>

  {# ── Structured data (schema.org) ──────────────────────────────
     The Person lives in partials/person-jsonld.njk, drawn on the home page
     and About, from facts.json. The WebSite node is on the home page only.
     Every page then describes itself — a WebPage (ProfilePage on About,
     with the Person as its main entity) and its breadcrumb — and points at
     the Person and the WebSite by @id. #}
  {%- if page.url == "/" or page.url == "/about/" %}
  {% include "partials/person-jsonld.njk" %}
  {%- endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {%- if page.url == "/" %}
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": {{ site.name | dump | safe }},
        "inLanguage": "en",
        "publisher": { "@id": "{{ site.url }}/#person" }
      },
      {%- endif %}
      {
        "@type": {{ pageSchemaType | dump | safe }},
        "@id": "{{ canonical }}#webpage",
        "url": "{{ canonical }}",
        "name": {{ pageTitle | dump | safe }},
        "description": {{ pageDesc | dump | safe }},
        "inLanguage": "en",
        {%- if tags and "posts" in tags %}
        "datePublished": "{{ page.date | isoDate }}",
        {%- endif %}
        "dateModified": "{{ pageModified | isoDate }}",
        "primaryImageOfPage": { "@type": "ImageObject", "url": {{ pageImage | dump | safe }} },
        "isPartOf": { "@id": "{{ site.url }}/#website" },
        "about": { "@id": "{{ site.url }}/#person" },
        {%- if pageSchemaType == "ProfilePage" %}
        "mainEntity": { "@id": "{{ site.url }}/#person" },
        {%- endif %}
        "breadcrumb": { "@id": "{{ canonical }}#breadcrumb" }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "{{ canonical }}#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" }
          {%- if page.url != "/" %}
          {%- if page.url.startsWith("/insights/") and page.url != "/insights/" %},
          { "@type": "ListItem", "position": 2, "name": "Insights", "item": "{{ site.url }}/insights/" },
          { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ canonical }}" }
          {%- else %},
          { "@type": "ListItem", "position": 2, "name": {{ title | dump | safe }}, "item": "{{ canonical }}" }
          {%- endif %}
          {%- endif %}
        ]
      }
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#1e4d3a">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ cssVersion }}" />
</head>
<body>
  <header class="site-header">
    <div class="header-container">
      <a href="/" class="brand">
       {{ site.name }}<span class="dot">.</span>
      </a>

     <input type="checkbox" id="nav-toggle" class="nav-toggle">

         <label for="nav-toggle" class="nav-toggle-label">
           <span></span>
         </label>

         <nav class="nav" aria-label="Main">
           <a href="/speaking/">Speaking</a>
           <a href="{{ facts.links.training }}">Team training</a>
           <a href="/partner/">Partnerships</a>
           <a href="/insights/">Insights</a>
           <a href="/about/">About</a>
           <a href="/contact/?type=speaking" class="btn btn--primary nav__cta">Book Maryna</a>
         </nav>
       </div>
     </header>

  <main class="main">
    <div class="container">
      {{ content | safe }}
    </div>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__brand">
        <div class="brand">{{ site.name }}</div>
        <p class="footer__tagline">Architecting the future of agrifood through AI, Education, Policy, and Human-First Innovation.</p>
      </div>

      {# External links carry ↗ and open in the same tab, as in the main nav. #}
      <div class="footer__grid">
        <div class="footer__col">
          <span class="footer__label">Work with me</span>
          <a href="/speaking/">Speaking</a>
          <a href="/events/">Events timeline</a>
          <a href="{{ facts.links.training }}">Team training</a>
          <a href="/partner/">Brand partnerships</a>
          <a href="/contact/">Contact</a>
        </div>
        <div class="footer__col">
          <span class="footer__label">Read &amp; follow</span>
          <a href="/insights/">Insights</a>
          <a href="/coverage/">Events I've covered</a>
          <a href="/ai-in-agriculture/">AI in Agriculture field guide</a>
          <a href="/books/">Books</a>
          <a href="{{ facts.newsletter.url }}">Newsletter ↗</a>
          <a href="{{ facts.live.url }}">{{ facts.live.short }} ↗</a>
          <span class="footer__inline">
            <a href="{{ site.social.linkedin }}">LinkedIn ↗</a> ·
            <a href="{{ site.social.youtube }}">YouTube ↗</a> ·
            <a href="{{ facts.links.courses }}">Courses ↗</a>
          </span>
        </div>
        <div class="footer__col">
          <span class="footer__label">About</span>
          <a href="/about/">About</a>
          <a href="/press-kit/">Press &amp; organiser kit</a>
          <a href="/moomore/">From crops to cattle (MooMore)</a>
          <a href="{{ facts.links.moomore }}">MooMore ↗</a>
          <a href="{{ facts.links.petiole }}">Petiole Pro ↗</a>
          <a href="https://moremaryna.com" target="_blank" rel="noopener">More Maryna</a>
        </div>
      </div>
    </div>

    <div class="container footer__bottom">
      <div class="footer__copyright">
        © 2026 · <a href="/">{{ site.name }}</a> · {{ facts.positioning.footer }}
      </div>
      <div class="footer__motto italic-text">
        Where Agriculture Meets AI.
      </div>
    </div>
  </footer>
</body>
</html>
