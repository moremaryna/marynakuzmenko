---
layout: layouts/base.njk
title: Speaking & Lectures
metaTitle: "AI in Agriculture Keynote Speaker | Dr. Maryna Kuzmenko"
description: "Book Dr. Maryna Kuzmenko, AI in agriculture keynote speaker, for conferences, summits, and lectures on agrifood AI and the future of farming."
---
{% from "partials/photo.njk" import photo %}
{% from "partials/event.njk" import spokenLine with context %}

{# The organiser questions, written once: the page prints them and the
   FAQPage structured data repeats them word for word. #}
{% set faq = [
  { q: "Can you speak online or hybrid?", a: "Yes — in person, online or hybrid." },
  { q: "Which languages?", a: facts.languages.firstPerson },
  { q: "Do you tailor the talk?", a: "Every session is customised. I don’t just deliver data; I deliver a perspective that resonates with the specific challenges of your region or sector." },
  { q: "Do you also train teams?", a: "Yes — workshops and multi-week courses, with BASIS CPD points through Petiole Ltd, are on my team training page." },
  { q: "What does it cost?", a: "Fees depend on format, travel and preparation. Send the date and audience and I'll reply with a quote " + facts.replyTime + "." }
] %}

<section class="speaking-hero">
  <span class="eyebrow">Keynotes · Panels · Lectures</span>
  <h1>AI in agriculture <span class="italic-text">keynote speaker</span></h1>
  <p class="lead">I help audiences look past the hype of AI to see the harvest of the future.</p>
  <div class="hero__actions" style="justify-content: center; margin-top: 30px;">
    <a href="/contact/?type=speaking" class="btn btn--primary">Check availability</a>
    <a href="/press-kit/" class="btn btn--ghost">Press &amp; organiser kit</a>
  </div>
  {% if facts.onesheetPdf %}
  <p style="margin-top: 18px;"><a class="text-link" href="{{ facts.onesheetPdf }}" download>Download one-sheet (PDF)</a></p>
  {% endif %}
</section>

<section class="section">
  <span class="eyebrow">Signature Topics</span>
  <div class="speaking-topics-grid">
    {% for talk in talks %}
    <div class="topic-card" id="{{ talk.slug }}">
      <div class="topic-icon">{{ "0" + loop.index if loop.index < 10 else loop.index }}</div>
      <h3>{{ talk.title }}</h3>
      <p>{{ talk.blurb }}</p>
      {% if talk.takeaway %}<p class="topic-meta"><strong>Takeaway:</strong> {{ talk.takeaway }}</p>{% endif %}
      <p class="topic-meta"><strong>Best for:</strong> {{ talk.bestFor }}</p>
      <p class="topic-formats">{{ talk.formats | join(" · ") }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section speaking-styles">
  <div class="style-grid">
    <div class="style-text">
      <span class="eyebrow">Engagement Formats</span>
      <h2>Tailored for Your Audience</h2>
      <p>Every session is customised. I don’t just deliver data; I deliver a perspective that resonates with the specific challenges of your region or sector.</p>
      <ul class="speaking-list">
        <li><strong>Keynote Addresses:</strong> Visionary and inspiring.</li>
        <li><strong>Technical Lectures:</strong> For universities and research institutes.</li>
        <li><strong>Panel Moderation:</strong> Driving deep, uncomfortable, and necessary discussions.</li>
        <li><strong>Team training and workshops:</strong> half-day to multi-week programmes for agrifood teams, with CPD points, are on <a class="inline-link" href="{{ facts.links.training }}">team training</a>.</li>
      </ul>
    </div>
    <div class="style-visual">
       <div class="speaking-photo">
         <img
           src="{{ photos.conferenceTalk.src }}"
           srcset="{{ photos.conferenceTalk.srcset }}"
           sizes="(max-width: 900px) 100vw, 520px"
           width="{{ photos.conferenceTalk.width }}"
           height="{{ photos.conferenceTalk.height }}"
           alt="{{ photos.conferenceTalk.alt }}"
           loading="lazy" decoding="async">
       </div>
    </div>
  </div>
</section>

<section class="section">
  <span class="eyebrow">Where I've spoken</span>
  <ul class="spoken-list">
    {% for e in events %}{% if e.highlight and e.type == "spoken" %}{{ spokenLine(e) }}{% endif %}{% endfor %}
  </ul>
  <p style="margin-top: 24px;"><a class="text-link" href="/events/">All appearances →</a></p>
</section>

{% include "partials/testimonials.njk" %}

<section class="section">
  <span class="eyebrow">On the stage, and on the screen</span>
  {# A remote lecture and an in-person one: both formats, as they look. #}
  <div class="photo-grid">
    {{ photo(photos.landscape2024, sizes="(max-width: 700px) 100vw, 520px") }}
    {{ photo(photos.conferenceConversation, sizes="(max-width: 700px) 100vw, 520px") }}
  </div>
</section>

<section class="section">
  <span class="eyebrow">For organisers</span>
  <h2>Questions, answered</h2>
  <div class="faq-list">
    {% for item in faq %}
    <div class="card faq-item">
      <h3>{{ item.q }}</h3>
      <p>{{ item.a }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section section--cta" style="background: var(--accent); color: white; border-radius: var(--radius); text-align: center; margin: 40px 0;">
  <h2 style="color: white;">Bring AI in agriculture to your stage.</h2>
  <a class="btn" style="background: white; color: var(--accent); margin-top: 20px;" href="/contact/?type=speaking">Check availability</a>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "{{ site.url }}{{ page.url }}#faq",
  "about": { "@id": "{{ site.url }}/#person" },
  "mainEntity": [{% for item in faq %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>
