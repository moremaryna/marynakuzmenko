---
layout: layouts/base.njk
title: Books
metaTitle: "Books by Dr. Maryna Kuzmenko — AI in Agriculture"
description: "Books by Dr. Maryna Kuzmenko on practical AI in agriculture: The Precision Vineyard, Seed Quality Control, and Vertical Farming — field guides for growers and the people who advise them."
permalink: "/books/"
image: "https://marynakuzmenko.com/assets/img/books/Maryna-Kuzmenko-The-Precision-Vineyard-Book-Cover.jpg"
ogType: "book"
---

<section class="hero">
  <span class="eyebrow">Books</span>
  <h1>Practical AI in agriculture, <span class="italic-text">written down.</span></h1>

  <p class="lead" style="max-width: 820px; margin: 0 auto 30px;">
    I write for growers and the people who advise them — field guides that say plainly what a technology
    does, what it costs, and whether it earns its place on your holding.
  </p>
</section>

{# Books come from src/_data/books.json. Covers load the 400/800px WebP
   renditions of the master named in `cover`. #}
{% for book in books %}
<section class="section" id="{{ book.id }}" style="border-top: 1px solid var(--border);">
  <span class="eyebrow">{% if book.series %}{{ book.series.name }} — Book {{ book.series.number }}{% else %}Also by Dr. Maryna Kuzmenko{% endif %}</span>
  <h2>{{ book.title }}</h2>

  <div class="card book-card" style="margin-top: 24px;">
    <a class="book-cover" href="{{ book.amazon.kindle }}" target="_blank" rel="noopener"
       aria-label="{{ book.title }} on Amazon">
      <img
        src="/assets/img/books/{{ book.cover }}-800.webp"
        srcset="/assets/img/books/{{ book.cover }}-400.webp 400w, /assets/img/books/{{ book.cover }}-800.webp 800w"
        sizes="(max-width: 700px) 220px, 240px"
        alt="Cover of {{ book.fullTitle }} by Dr. Maryna Kuzmenko"
        width="800" height="1280" loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async">
    </a>

    <div class="book-detail">
      <p class="book-subtitle"><strong>{{ book.subtitle }}</strong></p>

      {% for paragraph in book.description %}
      <p>{{ paragraph }}</p>
      {% endfor %}

      <details class="book-contents">
        <summary>What's inside</summary>
        <ol>
          {% for chapter in book.contents %}
          <li>{{ chapter }}</li>
          {% endfor %}
        </ol>
      </details>

      <div class="book-actions">
        <a class="btn btn--primary" href="{{ book.amazon.kindle }}" target="_blank" rel="noopener">Kindle on Amazon</a>
        <a class="btn btn--ghost" href="{{ book.amazon.paperback }}" target="_blank" rel="noopener">Paperback on Amazon</a>
      </div>

      <p class="book-meta">ISBN {{ book.isbn }}</p>
    </div>
  </div>
</section>
{% endfor %}

<section class="section">
  <span class="eyebrow">More</span>
  <h2>Where else I teach this</h2>

  <div class="grid" style="margin-top: 24px;">
    <div class="card">
      <h3>Courses</h3>
      <p>
        I teach AI in agriculture to {{ stats.udemy }} students across {{ stats.countries }} countries.
      </p>
      <a href="/ai-in-agriculture/" class="text-link">AI in Agriculture →</a>
    </div>

    <div class="card">
      <h3>Talks &amp; lectures</h3>
      <p>
        Keynotes, guest lectures, and conference sessions for universities, agrifood conferences,
        and innovation programmes.
      </p>
      <a href="/speaking/" class="text-link">Speaking →</a>
    </div>

    <div class="card">
      <h3>Writing</h3>
      <p>
        Notes and analysis on AI in agriculture, published regularly for a global agrifood audience.
      </p>
      <a href="/insights/" class="text-link">Insights →</a>
    </div>
  </div>
</section>

<section class="section section--cta">
  <h2>Writing, speaking, or teaching enquiries</h2>
  <p>For review copies, foreign rights, or an invitation to speak.</p>
  <a class="btn btn--primary" href="/contact/">Get in touch</a>
</section>

{# ── Book structured data ──────────────────────────────────────────
   Standalone Book nodes with stable @ids, authored by the same
   Person @id used site-wide, so the authorship resolves rather than
   restating a name. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BookSeries",
      "@id": "{{ site.url }}/books/#ai-in-agriculture-series",
      "name": "AI in Agriculture",
      "author": { "@id": "{{ site.url }}/#person" }
    },
    {%- for book in books %}
    {
      "@type": "Book",
      "@id": "{{ site.url }}/books/#{{ book.id }}",
      "name": {{ book.fullTitle | dump | safe }},
      "alternateName": {{ book.title | dump | safe }},
      "description": {{ book.summary | dump | safe }},
      "url": {{ book.amazon.kindle | dump | safe }},
      "isbn": {{ book.isbn | replace("-", "") | dump | safe }},
      "image": "{{ site.url }}/assets/img/books/{{ book.cover }}-800.webp",
      "author": { "@id": "{{ site.url }}/#person" },
      "inLanguage": "en",
      "about": {{ book.about | dump | safe }}{% if book.series %},
      "position": {{ book.series.number }},
      "isPartOf": { "@id": "{{ site.url }}/books/#ai-in-agriculture-series" }{% endif %}
    },
    {%- endfor %}
    {
      "@type": "CollectionPage",
      "@id": "{{ site.url }}{{ page.url }}#webpage-books",
      "url": "{{ site.url }}{{ page.url }}",
      "name": {{ metaTitle | dump | safe }},
      "about": { "@id": "{{ site.url }}/#person" },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [{% for book in books %}
          { "@type": "ListItem", "position": {{ loop.index }}, "item": { "@id": "{{ site.url }}/books/#{{ book.id }}" } }{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }
    }
  ]
}
</script>
