---
layout: layouts/base.njk
schemaType: ContactPage
title: Contact
metaTitle: "Contact Dr. Maryna Kuzmenko — Training, Teaching, Books & Speaking"
description: Inquire about AI training for your team, guest lectures, books, keynotes, brand partnerships, or media on AI in agriculture.
---

<section class="contact-hero">
  <span class="eyebrow">Let's Connect</span>
  <h1>Cultivating the <span class="italic-text">Next Dialogue.</span></h1>
  <p class="lead">Available for team training, guest lectures, keynotes, brand partnerships, and media on AI in agriculture.</p>
</section>

<div class="contact-container">
  <div class="contact-form-wrapper">
    {# The endpoint is site.contactEndpoint in _data/site.json: Formspree today,
       the Cloudflare Worker in cloudflare/contact-worker once it is deployed. #}
    <form action="{{ site.contactEndpoint }}" method="POST" class="contact-form">

      {# Honeypot: hidden from people, filled in by bots. The Worker drops any
         submission where it has a value. #}
      <div class="form-group form-group--hp" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" name="website" id="website" tabindex="-1" autocomplete="off">
      </div>

      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" name="name" id="name" placeholder="Jane Doe" required>
      </div>

      <div class="form-group">
        <label for="email">Work Email</label>
        <input type="email" name="email" id="email" placeholder="jane@organization.com" required>
      </div>

      <div class="form-group">
        <label for="subject">What can I help with?</label>
        <select name="subject" id="subject">
          <option value="Training">AI Training for My Team</option>
          <option value="Education">Guest Lecture / University Teaching</option>
          <option value="Book">Book / Writing</option>
          <option value="Speaking">Keynote / Speaking Engagement</option>
          <option value="Partnership">Brand Partnership</option>
          <option value="Media">Media / Press</option>
          <option value="Other">General Inquiry</option>
        </select>
      </div>

      <p id="inquiry-helper" class="inquiry-helper"></p>

      <!-- Adaptive: Training. The formats are the ones /training/ offers. -->
      <div class="adaptive-fields" data-inquiry="Training" hidden>
        <div class="form-group">
          <label for="organisation">Organisation</label>
          <input type="text" name="organisation" id="organisation" placeholder="Farm, company, institute or association">
        </div>
        <div class="form-group">
          <label for="training_format">Format</label>
          <select name="training_format" id="training_format">
            <option value="">Not sure yet</option>
            {%- for format in training.formats %}
            <option value="{{ format.name }}">{{ format.name }} ({{ format.length }})</option>
            {%- endfor %}
          </select>
        </div>
        <div class="form-group">
          <label for="team_size">Number of participants</label>
          <select name="team_size" id="team_size">
            <option value="">Select…</option>
            <option value="Up to 10">Up to 10</option>
            <option value="11–25">11–25</option>
            <option value="26–100">26–100</option>
            <option value="More than 100">More than 100</option>
          </select>
        </div>
        <div class="form-group">
          <label for="training_delivery">Delivery</label>
          <select name="training_delivery" id="training_delivery">
            <option value="">Select…</option>
            <option value="Online">Live online</option>
            <option value="On site">In person, on site</option>
            <option value="Hybrid">Hybrid</option>
          </select>
        </div>
      </div>

      <!-- Adaptive: Speaking -->
      <div class="adaptive-fields" data-inquiry="Speaking" hidden>
        <div class="form-group">
          <label for="event_name">Event / Organization</label>
          <input type="text" name="event_name" id="event_name" placeholder="Name of the event or host">
        </div>
        <div class="form-group">
          <label for="event_date">Event Date</label>
          <input type="date" name="event_date" id="event_date">
        </div>
        <div class="form-group">
          <label for="event_format">Format</label>
          <select name="event_format" id="event_format">
            <option value="">Select…</option>
            <option value="In-person">In-person</option>
            <option value="Virtual">Virtual</option>
            <option value="Hybrid">Hybrid</option>
          </select>
        </div>
      </div>

      <!-- Adaptive: Book -->
      <div class="adaptive-fields" data-inquiry="Book" hidden>
        <div class="form-group">
          <label for="book_request">What do you need?</label>
          <select name="book_request" id="book_request">
            <option value="">Select…</option>
            <option value="Review copy">Review copy</option>
            <option value="Foreign rights">Foreign rights / translation</option>
            <option value="Bulk order">Bulk or course order</option>
            <option value="Interview">Interview about the book</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </div>

      <!-- Adaptive: Partnership -->
      <div class="adaptive-fields" data-inquiry="Partnership" hidden>
        <div class="form-group">
          <label for="brand">Brand / Company</label>
          <input type="text" name="brand" id="brand" placeholder="Your brand or company">
        </div>
        <div class="form-group">
          <label for="collab_type">Collaboration Type</label>
          <select name="collab_type" id="collab_type">
            <option value="">Select…</option>
            <option value="Sponsored content">Sponsored content</option>
            <option value="Newsletter feature">Newsletter feature</option>
            <option value="Webinar / Workshop">Webinar / Workshop</option>
            <option value="Event appearance">Event appearance</option>
            <option value="Long-term partnership">Long-term partnership</option>
          </select>
        </div>
      </div>

      <!-- Adaptive: Media -->
      <div class="adaptive-fields" data-inquiry="Media" hidden>
        <div class="form-group">
          <label for="outlet">Outlet / Publication</label>
          <input type="text" name="outlet" id="outlet" placeholder="Where will this appear?">
        </div>
        <div class="form-group">
          <label for="deadline">Deadline</label>
          <input type="date" name="deadline" id="deadline">
        </div>
      </div>

      <div class="form-group">
        <label for="message">How can I help?</label>
        <textarea name="message" id="message" rows="6" placeholder="Tell me about your project or event..." required></textarea>
      </div>

      <button type="submit" class="btn btn--primary">Send Message</button>

    </form>
  </div>

  <div class="contact-info">
    <div class="info-block">
      <h3>Direct Outreach</h3>
      <p>For urgent press inquiries or quick professional intros, LinkedIn is often the fastest route.</p>
      <a href="{{ site.social.linkedin }}" class="text-link" target="_blank">Message on LinkedIn →</a>
    </div>

    <div class="info-block">
      <h3>Explore First</h3>
      <ul class="speaking-list" style="font-size: 14px;">
        <li><a class="text-link" href="/training/">Training for teams</a></li>
        <li><a class="text-link" href="/ai-in-agriculture/">Free course</a></li>
        <li><a class="text-link" href="/books/">Books</a></li>
        <li><a class="text-link" href="/speaking/">Keynotes &amp; speaking</a></li>
        <li><a class="text-link" href="/partner/">Brand partnerships</a></li>
      </ul>
    </div>

    <div class="info-block">
      <h3>Location</h3>
      <p>Based in the UK · Working Globally.</p>
    </div>
  </div>
</div>

<style>
  .inquiry-helper {
    margin: -8px 0 18px;
    font-size: 14px;
    color: var(--muted);
    min-height: 1em;
  }
  .inquiry-helper:empty { margin: 0; }
  .form-group--hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  (function () {
    const form = document.querySelector(".contact-form");
    if (!form) return;

    const select = document.getElementById("subject");
    const groups = form.querySelectorAll(".adaptive-fields");
    const helper = document.getElementById("inquiry-helper");

    const helpers = {
      Training: "Tell me about your team, your sector and what you'd like them to be able to do. You'll get a tailored proposal and quote, usually within two working days.",
      Education: "Tell me about the course, module or lecture series, and what your students need.",
      Book: "Let me know which book and what you need — review copy, rights, or an interview.",
      Speaking: "Share your event details and I'll come back with availability and formats.",
      Partnership: "Tell me about the campaign, audience, and timeline, and I'll send the media kit.",
      Media: "Let me know your outlet and deadline so I can respond in time.",
      Other: ""
    };

    function sync() {
      const val = select.value;
      groups.forEach((g) => {
        g.hidden = g.getAttribute("data-inquiry") !== val;
      });
      if (helper) helper.textContent = helpers[val] || "";
    }

    // Pre-select inquiry type from the URL, e.g. /contact/?type=advisory
    const requested = new URLSearchParams(window.location.search).get("type");
    if (requested) {
      const map = {
        speaking: "Speaking", keynote: "Speaking",
        partnership: "Partnership", partner: "Partnership", brand: "Partnership",
        media: "Media", press: "Media",
        training: "Training", workshop: "Training", team: "Training", course: "Training",
        education: "Education", teaching: "Education", lecture: "Education",
        book: "Book", books: "Book", writing: "Book",
        general: "Other"
      };
      const matched = map[requested.toLowerCase()];
      if (matched) select.value = matched;
    }

    select.addEventListener("change", sync);
    sync();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const formData = new FormData(form);

        const res = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { "Accept": "application/json" }
        });

        if (res.ok) {
          window.location.href = "/success/";
          return;
        }

        let msg = "Sorry — something went wrong. Please try again.";
        try {
          const data = await res.json();
          if (data && data.errors && data.errors.length) {
            msg = data.errors.map(er => er.message).join(" ");
          }
        } catch (_) {}

        alert(msg);
      } catch (err) {
        alert("Network error — please try again, or message me on LinkedIn.");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  })();
</script>
