---
layout: layouts/base.njk
schemaType: ContactPage
title: Contact
metaTitle: "Book or Contact Dr. Maryna Kuzmenko — Speaking, Training & Partnerships"
eleventyComputed:
  description: "Check Dr. Maryna Kuzmenko's availability for keynotes, team training, brand partnerships or media on AI in agriculture. Replies {{ facts.replyTime }}."
---
{#
  One form for every kind of enquiry. "What can I help with?" decides which
  extra fields appear; its values are the keys /contact/?type= accepts, so a
  link such as /contact/?type=speaking opens the form ready for a booking.

  The extra fields sit in disabled fieldsets until their enquiry type is
  chosen, so only the fields that apply are sent. Without JavaScript the
  form still posts: as "Something else", with the fields everyone sees.
#}

<section class="contact-hero">
  <span class="eyebrow">Let's Connect</span>
  <h1>Book Maryna or <span class="italic-text">get in touch</span></h1>
  <p class="lead">Keynotes, team training, brand partnerships and media. I reply {{ facts.replyTime }}.</p>
</section>

<div class="contact-container">
  <div class="contact-form-wrapper">
    {# The endpoint is site.contactEndpoint in _data/site.json: Formspree today,
       the Cloudflare Worker in cloudflare/contact-worker once it is deployed. #}
    <form action="{{ site.contactEndpoint }}" method="POST" class="contact-form">

      {# Honeypot: hidden from people, filled in by bots. The Worker drops any
         submission where it has a value. #}
      <div class="form-group form-group--hp" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" name="website" id="website" tabindex="-1" autocomplete="off">
      </div>

      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" name="name" id="name" placeholder="Jane Doe" autocomplete="name" required>
      </div>

      <div class="form-group">
        <label for="email">Work Email</label>
        <input type="email" name="email" id="email" placeholder="jane@organisation.com" autocomplete="email" required>
      </div>

      <div class="form-group">
        <label for="organisation">Organisation</label>
        <input type="text" name="organisation" id="organisation" placeholder="Company, university or event" autocomplete="organization">
      </div>

      <div class="form-group">
        <label for="subject">What can I help with?</label>
        <select name="subject" id="subject">
          <option value="speaking">Keynote, panel or speaking engagement</option>
          <option value="training">Team training or workshop</option>
          <option value="lecture">Guest lecture (university or research institute)</option>
          <option value="partnership">Brand partnership</option>
          <option value="media">Media or press</option>
          <option value="books">Books or writing</option>
          <option value="other" selected>Something else</option>
        </select>
      </div>

      <p id="inquiry-helper" class="inquiry-helper"></p>

      <!-- Adaptive: speaking, training, lecture -->
      <fieldset class="adaptive-fields" data-inquiry="speaking training lecture" hidden disabled>
        <p class="adaptive-note" data-note-for="training">
          Formats and topics are outlined on <a class="inline-link" href="{{ facts.links.training }}">aiinagriculture.org</a> ↗ — you can still send your enquiry here.
        </p>
        <div class="form-group">
          <label for="event_name">Event or programme name</label>
          <input type="text" name="event_name" id="event_name" placeholder="Name of the event, course or programme">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="event_date">Event Date</label>
            <input type="date" name="event_date" id="event_date">
          </div>
          <div class="form-group">
            <label for="event_format">Format</label>
            <select name="event_format" id="event_format">
              <option value="">Select…</option>
              <option value="In person">In person</option>
              <option value="Online">Online</option>
              <option value="Hybrid">Hybrid</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="event_location">City and country</label>
            <input type="text" name="event_location" id="event_location" placeholder="e.g. Birmingham, UK">
          </div>
          <div class="form-group">
            <label for="audience_size">Audience size</label>
            <select name="audience_size" id="audience_size">
              <option value="">Select…</option>
              <option value="Under 50">Under 50</option>
              <option value="50–200">50–200</option>
              <option value="200–500">200–500</option>
              <option value="500+">500+</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="audience">Who will be in the room</label>
          <input type="text" name="audience" id="audience" placeholder="e.g. growers, agronomists, a board, students">
        </div>
        <div class="form-group">
          <label for="budget">Budget <span class="form-optional">(optional)</span></label>
          <input type="text" name="budget" id="budget">
        </div>
      </fieldset>

      <!-- Adaptive: partnership -->
      <fieldset class="adaptive-fields" data-inquiry="partnership" hidden disabled>
        <div class="form-group">
          <label for="collab_type">Collaboration Type</label>
          <select name="collab_type" id="collab_type">
            <option value="">Select…</option>
            <option value="Sponsored content">Sponsored content</option>
            <option value="Newsletter feature">Newsletter feature</option>
            <option value="Webinar / Workshop">Webinar / Workshop</option>
            <option value="Event appearance">Event appearance</option>
            <option value="Long-term partnership">Long-term partnership</option>
          </select>
        </div>
        <div class="form-group">
          <label for="partnership_deadline">Deadline</label>
          <input type="date" name="deadline" id="partnership_deadline">
        </div>
      </fieldset>

      <!-- Adaptive: media -->
      <fieldset class="adaptive-fields" data-inquiry="media" hidden disabled>
        <div class="form-group">
          <label for="outlet">Outlet / Publication</label>
          <input type="text" name="outlet" id="outlet" placeholder="Where will this appear?">
        </div>
        <div class="form-group">
          <label for="media_deadline">Deadline</label>
          <input type="date" name="deadline" id="media_deadline">
        </div>
      </fieldset>

      <!-- Adaptive: books -->
      <fieldset class="adaptive-fields" data-inquiry="books" hidden disabled>
        <div class="form-group">
          <label for="book_request">What do you need?</label>
          <select name="book_request" id="book_request">
            <option value="">Select…</option>
            <option value="Review copy">Review copy</option>
            <option value="Foreign rights">Foreign rights / translation</option>
            <option value="Bulk order">Bulk or course order</option>
            <option value="Interview">Interview about the book</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </fieldset>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea name="message" id="message" rows="6" placeholder="Tell me about your event, team or project..." required></textarea>
      </div>

      <button type="submit" class="btn btn--primary">Send Message</button>

    </form>
  </div>

  <div class="contact-info">
    <div class="info-block">
      <h3>Direct Outreach</h3>
      <p>For urgent press inquiries or quick professional intros, LinkedIn is often the fastest route.</p>
      <a href="{{ site.social.linkedin }}" class="text-link" target="_blank" rel="noopener">Message on LinkedIn →</a>
    </div>

    <div class="info-block">
      <h3>Explore First</h3>
      <ul class="speaking-list" style="font-size: 14px;">
        <li><a class="text-link" href="/speaking/">Keynotes &amp; speaking</a></li>
        <li><a class="text-link" href="{{ facts.links.training }}">Team training ↗</a></li>
        <li><a class="text-link" href="/partner/">Brand partnerships</a></li>
        <li><a class="text-link" href="/press-kit/">Press &amp; organiser kit</a></li>
        <li><a class="text-link" href="/books/">Books</a></li>
      </ul>
    </div>

    <div class="info-block">
      <h3>Location</h3>
      <p>Based in the UK · Working Globally.</p>
    </div>
  </div>
</div>

<style>
  .inquiry-helper {
    margin: -8px 0 0;
    font-size: 14px;
    color: var(--muted);
    min-height: 1em;
  }
  .inquiry-helper:empty { display: none; }
  .adaptive-fields {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .adaptive-fields[hidden] { display: none; }
  .adaptive-note {
    margin: 0;
    padding: 14px 18px;
    border-left: 3px solid var(--gold);
    background: rgba(30, 77, 58, 0.04);
    border-radius: 0 12px 12px 0;
    font-size: 14px;
  }
  .adaptive-note[hidden] { display: none; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form-row .form-group { min-width: 0; }
  .form-optional { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--muted); }
  @media (max-width: 560px) {
    .form-row { grid-template-columns: 1fr; gap: 24px; }
  }
  .form-group--hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  (function () {
    const form = document.querySelector(".contact-form");
    if (!form) return;

    const select = document.getElementById("subject");
    const groups = form.querySelectorAll(".adaptive-fields");
    const notes = form.querySelectorAll("[data-note-for]");
    const helper = document.getElementById("inquiry-helper");

    const helpers = {
      speaking: "Share your event details and I'll come back with availability and formats.",
      training: "",
      lecture: "Tell me about the course or programme, and what your students need.",
      partnership: "Tell me about the campaign, audience, and timeline, and I'll send the partnership media kit.",
      media: "Let me know your outlet and deadline so I can respond in time.",
      books: "Let me know which book and what you need — review copy, rights, or an interview.",
      other: ""
    };

    // Show the fields for the chosen enquiry, and send only those.
    function sync() {
      const val = select.value;
      groups.forEach((g) => {
        const on = g.getAttribute("data-inquiry").split(" ").includes(val);
        g.hidden = !on;
        g.disabled = !on;
      });
      notes.forEach((n) => { n.hidden = n.getAttribute("data-note-for") !== val; });
      if (helper) helper.textContent = helpers[val] || "";
    }

    // Pre-select the enquiry from the URL, e.g. /contact/?type=speaking.
    // Older links used other words for the same things; they still work.
    const requested = (new URLSearchParams(window.location.search).get("type") || "").toLowerCase();
    const aliases = {
      keynote: "speaking", advisory: "speaking",
      workshop: "training", education: "training", course: "training", teaching: "training",
      partner: "partnership", brand: "partnership",
      press: "media",
      book: "books", writing: "books",
      general: "other"
    };
    const wanted = aliases[requested] || requested;
    if (helpers.hasOwnProperty(wanted)) select.value = wanted;

    select.addEventListener("change", sync);
    sync();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const formData = new FormData(form);

        const res = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { "Accept": "application/json" }
        });

        if (res.ok) {
          window.location.href = "/success/";
          return;
        }

        let msg = "Sorry — something went wrong. Please try again.";
        try {
          const data = await res.json();
          if (data && data.errors && data.errors.length) {
            msg = data.errors.map(er => er.message).join(" ");
          }
        } catch (_) {}

        alert(msg);
      } catch (err) {
        alert("Network error — please try again, or message me on LinkedIn.");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  })();
</script>
