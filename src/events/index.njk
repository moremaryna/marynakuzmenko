---
layout: layouts/base.njk
schemaType: CollectionPage
title: Events & Engagements
metaTitle: "Events & Engagements | Dr. Maryna Kuzmenko"
metaDescription: "A timeline of Dr. Maryna Kuzmenko's events: keynotes, university lectures, agrifood shows she has reported on, and recognition, across the UK, Europe, Africa, Asia and the Americas."
---
{# The whole history, newest first: every entry in src/_data/events.js on one
   timeline — talks, the shows Maryna attended and reported on, and
   recognition — as the page was before the October 2026 restructure split
   it. /coverage/ still gathers the shows on their own. #}
{% from "partials/event.njk" import eventItem with context %}

<section class="events-hero">
  <span class="eyebrow">The Global Stage</span>
  <h1>Sharing Knowledge <span class="italic-text">Across Borders.</span></h1>
  <p class="lead">
    From university lecture halls to international stages, I translate complex AI trends into actionable agricultural innovation.
  </p>
</section>

<div class="events-timeline">
  {% for e in events %}{% if not e.archive %}
  {{ eventItem(e) }}
  {% endif %}{% endfor %}
</div>

<section class="events-archive">
  <div class="container">
    <h3>Selected Past Engagements</h3>
    <div class="archive-grid">
      {% for e in events %}{% if e.archive %}
      <div class="archive-item">
        <a href="{{ e.links[0].url }}" target="_blank" rel="noopener"><strong>{{ e.title }}</strong></a>
        <span>{{ e.organiser }} · {{ e.location }}</span>
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="section section--cta">
  <h2>Bring AI innovation to your stage.</h2>
  <p>Available for keynotes, guest lectures and other speaking engagements.</p>
  <a class="btn btn--primary" href="/contact/?type=speaking">Book Maryna</a>
</section>
