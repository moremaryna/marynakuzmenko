&lt;/figure&gt;

  
&lt;figure class=&quot;page-figure&quot;&gt;
  &lt;img
    src=&quot;/assets/img/events/2026-09-23-WATIS-2/spot-robot-world-agri-tech-london-2026-1200.webp&quot;
